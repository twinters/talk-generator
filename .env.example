# Copy this file to `.env` (in the folder you run talkgenerator from) and fill in the keys you have.
# Every key is optional: sources without credentials are skipped and the other sources fill in.
# Never commit your .env file: it's in .gitignore.

# Reddit (memes, gifs, vintage photos, charts...): create a "script" app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Describe your app and include your Reddit username, e.g. "talkgenerator/4.0 (by u/your_username)"
REDDIT_USER_AGENT=

# Unsplash photos: https://unsplash.com/oauth/applications (new apps get 50 requests per hour until approved)
UNSPLASH_ACCESS_KEY=

# Pixabay photos: https://pixabay.com/api/docs/
PIXABAY_KEY=

# Pexels photos: https://www.pexels.com/api/
PEXELS_KEY=

# GIPHY gifs: https://developers.giphy.com/dashboard/
GIPHY_API_KEY=

# Openverse photos work without keys too; a registered app gets higher rate limits once you verify its email
# address. Register at https://api.openverse.org/v1/#tag/auth/operation/register (the answer has both keys).
OPENVERSE_CLIENT_ID=
OPENVERSE_CLIENT_SECRET=

# Optional (talkgenerator 5): a language model writes the talks (see "Language models" in the README).
# OpenRouter's free models write them whenever there's an OpenRouter key (free at https://openrouter.ai/settings/keys;
# needs pip install 'talkgenerator[openai]'). Other models only write talks when TALKGENERATOR_LLM names them:
# "anthropic" (Claude Opus 5.5) or "anthropic:<model>", with an Anthropic key (pip install 'talkgenerator[anthropic]'),
# or "openai:<model>", with an OpenAI key. "none", or DISABLE_LLM=1, makes classic talks, as the 2019 generator did.
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# TALKGENERATOR_LLM=openrouter
# How hard the model thinks before it writes (low, medium, high), for the models that take it; Claude uses low
# TALKGENERATOR_LLM_EFFORT=low

# Optional: your app's name at Unsplash, used in the utm_source of the links to photographers' profiles
# UNSPLASH_APP_NAME=talkgenerator

# Optional: a (self-hosted) ConceptNet API. The public one has been down since late 2025; without it,
# related words come from Datamuse and WordNet instead.
# CONCEPTNET_API_URL=https://api.conceptnet.io

# Optional: switch off individual sources with DISABLE_<SOURCE>=1.
# Sources: REDDIT, UNSPLASH, PIXABAY, PEXELS, GIPHY, OPENVERSE, WIKIMEDIA_COMMONS, ART_INSTITUTE,
#          WIKIHOW, WIKIQUOTE, SHITPOSTBOT, CONCEPTNET
# DISABLE_WIKIHOW=1

# Optional: where NLTK data lives (downloaded automatically on first run if missing)
# NLTK_DATA=/path/to/nltk_data

# Optional: search API responses are cached on disk in your user cache folder (API keys are never stored).
# TALKGENERATOR_CACHE_DIR=/path/to/cache
# DISABLE_CACHE=1
