{
  "format": "documentary",
  "about": "The classic texts of nature documentaries (the documentary schema): a grammar per part of its arc, whose rules are lists of templates (see talkgenerator.sources.packs and talkgenerator.schema.formats.documentary)",
  "version": 1,
  "versions": {
    "1": "2026-11-12: the first texts of nature documentaries, a part of the arc a grammar: the title, the opening shot, the habitat, the behaviour, the rare sighting, the ritual, the threat and the closing, and the free slides' quiz on the species and provocations (D79)"
  },
  "slots": {
    "title.talk_title": {"variables": ["seed", "species"], "field": "title.title"},
    "title.subtitle": {"variables": ["seed", "topic", "presenter", "title", "species"], "field": "title.subtitle"},
    "free.provocation": {"variables": ["seed", "topic", "presenter", "title", "species"], "field": "full_image.title"},
    "free.question_*": {"variables": ["seed", "topic", "presenter", "title", "species"], "field": "quiz.question"},
    "free.options_*": {"variables": ["seed", "topic", "presenter", "title", "species"], "field": "quiz.option_a"},
    "free.why_*": {"variables": ["seed", "topic", "presenter", "title", "species"], "field": "quiz.explanation"},
    "opening.dawn": {"variables": ["seed", "topic", "presenter", "title", "species"], "field": "full_image.title"},
    "opening.planet": {"variables": ["seed", "topic", "presenter", "title", "species"], "field": "statement.text"},
    "habitat.home_title": {"variables": ["seed", "topic", "presenter", "title", "species"], "field": "image.title"},
    "habitat.range_question": {"variables": ["seed", "topic", "presenter", "title", "species"], "field": "chart_categories.question"},
    "habitat.range": {"variables": ["seed", "topic", "presenter", "title", "species"], "limit": 26},
    "habitat.fact": {"variables": ["seed", "topic", "presenter", "title", "species"], "field": "fun_fact.fact"},
    "habitat.fact_source": {"variables": ["seed", "topic", "presenter", "title", "species"], "field": "fun_fact.source"},
    "behaviour.behaviour_title": {"variables": ["seed", "topic", "presenter", "title", "species"], "field": "three_columns.title"},
    "behaviour.activity": {"variables": ["seed", "topic", "presenter", "title", "species"], "field": "three_columns.caption_1"},
    "behaviour.activity_punchline": {"variables": ["seed", "topic", "presenter", "title", "species"], "field": "three_columns.caption_3"},
    "behaviour.pair_title": {"variables": ["seed", "topic", "presenter", "title", "species"], "field": "two_columns.title"},
    "behaviour.pair": {"variables": ["seed", "topic", "presenter", "title", "species"], "field": "two_columns.caption_1", "parts": 2},
    "behaviour.cycle_title": {"variables": ["seed", "topic", "presenter", "title", "species"], "field": "cycle.title"},
    "behaviour.cycle_step": {"variables": ["seed", "topic", "presenter", "title", "species"], "field": "cycle.step_1"},
    "sighting.rare": {"variables": ["seed", "topic", "presenter", "title", "species"], "field": "full_image.title"},
    "sighting.outlet": {"variables": ["seed", "topic", "presenter", "title", "species"], "field": "news_headline.outlet"},
    "sighting.headline": {"variables": ["seed", "topic", "presenter", "title", "species"], "field": "news_headline.headline"},
    "sighting.subheadline": {"variables": ["seed", "topic", "presenter", "title", "species"], "field": "news_headline.subheadline"},
    "ritual.ancient": {"variables": ["seed", "topic", "presenter", "title", "species"], "field": "full_image.title"},
    "ritual.dance_title": {"variables": ["seed", "topic", "presenter", "title", "species"], "field": "process.title"},
    "ritual.dance_first": {"variables": ["seed", "topic", "presenter", "title", "species"], "field": "process.step_1"},
    "ritual.dance_step": {"variables": ["seed", "topic", "presenter", "title", "species"], "field": "process.step_2"},
    "ritual.dance_last": {"variables": ["seed", "topic", "presenter", "title", "species"], "field": "process.step_3"},
    "threat.left_title": {"variables": ["seed", "topic", "presenter", "title", "species"], "field": "big_number.title"},
    "threat.left_number": {"variables": [], "field": "big_number.number"},
    "threat.left_label": {"variables": ["seed", "topic", "presenter", "title", "species"], "field": "big_number.label"},
    "threat.left_source": {"variables": ["seed", "topic", "presenter", "title", "species"], "field": "big_number.source"},
    "threat.trend_title": {"variables": ["seed", "topic", "presenter", "title", "species"], "field": "chart_trend.title"},
    "threat.trend_x": {"variables": ["seed", "topic", "presenter", "title", "species"], "field": "chart_trend.x_axis"},
    "threat.trend_y": {"variables": ["seed", "topic", "presenter", "title", "species"], "field": "chart_trend.y_axis"},
    "threat.trend_event": {"variables": ["seed", "topic", "presenter", "title", "species"], "field": "chart_trend.event"},
    "threat.danger": {"variables": ["seed", "topic", "presenter", "title", "species"], "field": "statement.text"},
    "closing.reflection": {"variables": ["seed", "topic", "presenter", "title", "species"], "field": "statement.text"},
    "closing.farewell": {"variables": ["seed", "topic", "presenter", "title", "species"], "field": "full_image.title"},
    "closing.hush": {"variables": ["seed", "topic", "presenter", "title", "species"], "field": "dare.audience"}
  }
