{
  "format": "ted",
  "about": "The classic texts of TED-like talks (the default, ted, interview and test schemas): a grammar per kind of slide, whose rules are lists of templates (see talkgenerator.sources.packs)",
  "version": 1,
  "versions": {
    "1": "2026-11-08: v4's templates and milestone 6's, from data/text-templates and data/memes.json, unchanged (D52)"
  },
  "slots": {
    "title.talk_title": {"variables": ["seed"], "field": "title.title"},
    "title.ted_title": {"variables": ["seed"], "field": "title.title"},
    "title.subtitle": {"variables": ["seed", "topic", "presenter", "title"], "field": "title.subtitle"},
    "about_me.about_me_title": {"variables": ["seed", "topic", "presenter", "title"], "field": "three_columns.title"},
    "about_me.book_description": {"variables": ["seed", "topic", "presenter", "title"], "field": "three_columns.caption_2"},
    "about_me.location_description": {"variables": ["seed", "topic", "presenter", "title"], "field": "three_columns.caption_1"},
    "about_me.hobby_description": {"variables": ["seed", "topic", "presenter", "title"], "field": "three_columns.caption_3"},
    "about_me.job": {"variables": ["seed", "topic", "presenter", "title"], "field": "three_columns.caption_2"},
    "about_me.country": {"variables": ["seed", "topic", "presenter", "title"], "field": "three_columns.caption_1"},
    "about_me.job_description": {"variables": [], "field": "three_columns.caption_2"},
    "about_me.country_description": {"variables": [], "field": "three_columns.caption_1"},
    "history.history_title": {"variables": ["seed", "topic", "presenter", "title"], "field": "history_quote.title"},
