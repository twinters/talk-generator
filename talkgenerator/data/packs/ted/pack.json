    "history.historic_captions": {"variables": ["seed", "topic", "presenter", "title"], "field": "two_columns.caption_1", "parts": 2},
    "images.slide_title": {"variables": ["seed", "topic", "presenter", "title"], "field": "image.title"},
    "images.anticipation_title": {"variables": ["seed", "topic", "presenter", "title"], "field": "full_image.title"},
    "images.inspiration_title": {"variables": ["seed", "topic", "presenter", "title"], "field": "image.title"},
    "statements.bold_statement": {"variables": ["seed", "topic", "presenter", "title", "action"], "field": "statement.text"},
    "statements.anecdote": {"variables": ["seed", "topic", "presenter", "title"], "field": "statement.text"},
    "statements.deep_question": {"variables": ["seed", "topic", "presenter", "title"], "field": "statement.text"},
    "captions.two_captions": {"variables": ["seed", "topic", "presenter", "title"], "field": "two_columns.caption_1", "parts": 2},
