    "diagrams.org_chart_boss": {"variables": ["seed"], "field": "org_chart.boss"},
    "diagrams.org_chart_report": {"variables": ["seed", "related"], "field": "org_chart.report_1"},
    "diagrams.iceberg_title": {"variables": ["seed"], "field": "iceberg.title"},
    "diagrams.iceberg_hidden": {"variables": ["seed", "related"], "field": "iceberg.hidden_1"},
    "numbers.big_number_title": {"variables": ["seed"], "field": "big_number.title"},
    "numbers.percent_label": {"variables": ["seed"], "field": "big_number.label"},
    "numbers.count_label": {"variables": ["seed"], "field": "big_number.label"},
    "numbers.ratio_label": {"variables": ["seed"], "field": "big_number.label"},
    "numbers.big_number_source": {"variables": ["seed"], "field": "big_number.source"},
    "numbers.kpi_title": {"variables": ["seed", "related"], "field": "kpi.title"},
    "numbers.kpi_label": {"variables": ["seed", "related"], "field": "kpi.label_1"},
    "numbers.kpi_punchline": {"variables": ["seed", "related"], "field": "kpi.label_4"},
    "quiz.quiz_question": {"variables": ["seed"], "field": "quiz.question"},
    "quiz.quiz_explanation": {"variables": ["seed"], "field": "quiz.explanation"},
    "mockups.post_title": {"variables": ["seed"], "field": "social_post.title"},
    "mockups.post_text": {"variables": ["seed"], "field": "social_post.text"},
    "mockups.news_outlet": {"variables": ["seed"], "field": "news_headline.outlet"},
    "mockups.news_headline": {"variables": ["seed"], "field": "news_headline.headline"},
    "mockups.news_subheadline": {"variables": ["seed"], "field": "news_headline.subheadline"},
    "structure.agenda_title": {"variables": ["seed"], "field": "agenda.title"},
    "structure.agenda_first": {"variables": ["seed"], "limit": 45},
    "structure.agenda_item": {"variables": ["seed", "related"], "limit": 45},
    "structure.agenda_last": {"variables": ["seed"], "limit": 45},
    "structure.section_title": {"variables": ["seed"], "field": "section.title"},
    "structure.section_subtitle": {"variables": ["seed"], "field": "section.subtitle"},
    "structure.questions_title": {"variables": ["seed"], "field": "questions.title"},
    "structure.questions_subtitle": {"variables": ["seed"], "field": "questions.subtitle"},
    "karaoke.fun_fact": {"variables": ["seed", "related", "number", "percent", "year"], "field": "fun_fact.fact"},
    "karaoke.fun_fact_years": {"variables": [], "limit": 4},
    "karaoke.acronym_title": {"variables": ["seed", "acronym"], "field": "acronym.title"},
    "karaoke.acronyms": {"variables": [], "field": "acronym.acronym"},
    "karaoke.buzzword_*": {"variables": [], "field": "acronym.word_1"},
    "karaoke.absurd_*": {"variables": [], "field": "acronym.word_1"},
    "karaoke.dare": {"variables": ["seed", "related"], "field": "dare.dare"},
    "karaoke.flowchart_title": {"variables": ["seed"], "field": "flowchart.title"},
    "karaoke.flowchart_question": {"variables": ["seed"], "field": "flowchart.question"},
    "karaoke.flowchart_yes": {"variables": ["seed", "related"], "field": "flowchart.yes_step"},
    "karaoke.flowchart_no": {"variables": ["seed", "related"], "field": "flowchart.no_step"},
    "karaoke.flowchart_end": {"variables": ["seed", "related"], "field": "flowchart.end"},
    "karaoke.tier_list_title": {"variables": ["seed"], "field": "tier_list.title"},
    "karaoke.tier_list_worst": {"variables": [], "field": "tier_list.f_tier"},
    "memes.*": {"variables": ["seed", "related"], "field": "meme.text_1"},
    "conclusions.conclusion_title": {"variables": ["seed", "topic", "presenter", "title"], "field": "two_columns.title"},
    "conclusions.two_conclusions": {"variables": ["seed", "topic", "presenter", "title"], "field": "two_columns.caption_1", "parts": 2},
    "conclusions.three_conclusions": {"variables": ["seed", "topic", "presenter", "title"], "field": "three_columns.caption_1", "parts": 3}
  }
